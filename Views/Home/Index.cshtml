@model QRCodeGenerator.Models.QrCodeViewModel
@using QRCodeGenerator.Services

@{
    var language = Model.Language;
    ViewData["Title"] = UiText.Get(language, "HeroTitle");
    var hasResult = Model.ShowResult;
    var generatedPayload = Model.GeneratedPayload ?? string.Empty;
    var isValidated = Model.ValidationResult is not null;
    var readabilityStars = Model.ValidationResult is null ? 0 : (int)Math.Ceiling(Model.ValidationResult.ReadabilityScore / 20.0);
    var printSafetyStars = Model.ValidationResult is null ? 0 : (int)Math.Ceiling(Model.ValidationResult.PrintSafetyScore / 20.0);
    var contentIcons = new Dictionary<string, string>
    {
        ["general"] = "edit_note",
        ["url"] = "link",
        ["wifi"] = "wifi",
        ["vcard"] = "person",
        ["email"] = "mail",
        ["sms"] = "sms",
        ["phone"] = "call",
        ["geo"] = "location_on",
        ["event"] = "event",
        ["crypto"] = "account_balance_wallet",
        ["app"] = "apps",
        ["pdf"] = "picture_as_pdf",
        ["social"] = "alternate_email",
        ["multilink"] = "hub",
        ["plain"] = "notes"
    };
}

<section class="generator-stage">
    <div class="ambient ambient-one"></div>
    <div class="ambient ambient-two"></div>

    <section class="hero-panel glass-panel">
        <div class="hero-copy">
            <span class="kicker">@UiText.Get(language, "HeroKicker")</span>
            <h1>@UiText.Get(language, "HeroTitle")</h1>
            <p>@UiText.Get(language, "HeroCopy")</p>
        </div>

        <div class="workspace-grid">
            <form asp-action="Index" method="post" enctype="multipart/form-data" class="config-panel">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="field-block">
                    <span class="field-label">@UiText.Get(language, "ContentType")</span>
                    <div class="content-picker" role="radiogroup" aria-label="@UiText.Get(language, "ContentType")">
                        @foreach (var option in Model.ContentTypeOptions)
                        {
                            var id = $"content-{option.Value}";
                            var icon = contentIcons.TryGetValue(option.Value, out var iconName) ? iconName : "qr_code";
                            <input class="visually-hidden content-radio" type="radio" asp-for="ContentType" id="@id" value="@option.Value" />
                            <label class="content-chip" for="@id">
                                <span class="material-symbols-outlined">@icon</span>
                                <span>@UiText.Get(language, $"ContentType_{option.Value}")</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="field-block content-panel" data-content-panel="general">
                    <label asp-for="Text" class="field-label">@UiText.Get(language, "Text")</label>
                    <textarea asp-for="Text" class="neo-input" rows="4" placeholder="@UiText.Get(language, "TextPlaceholder")"></textarea>
                    <span asp-validation-for="Text" class="field-error"></span>
                </div>

                <div class="field-block content-panel" data-content-panel="url">
                    <label asp-for="Url" class="field-label">@UiText.Get(language, "Url")</label>
                    <input asp-for="Url" class="neo-input input-lg" placeholder="https://example.com" />
                    <span asp-validation-for="Url" class="field-error"></span>
                </div>

                <div class="form-grid content-panel" data-content-panel="wifi">
                    <div>
                        <label asp-for="WifiSsid" class="field-label">@UiText.Get(language, "WifiSsid")</label>
                        <input asp-for="WifiSsid" class="neo-input" />
                        <span asp-validation-for="WifiSsid" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="WifiPassword" class="field-label">@UiText.Get(language, "WifiPassword")</label>
                        <input asp-for="WifiPassword" class="neo-input" />
                    </div>
                    <div>
                        <label asp-for="WifiEncryption" class="field-label">@UiText.Get(language, "WifiEncryption")</label>
                        <select asp-for="WifiEncryption" class="neo-input">
                            <option value="WPA">WPA/WPA2</option>
                            <option value="WEP">WEP</option>
                            <option value="nopass">@UiText.Get(language, "NoPassword")</option>
                        </select>
                    </div>
                    <label class="toggle-line">
                        <input asp-for="WifiHidden" type="checkbox" />
                        <span>@UiText.Get(language, "WifiHidden")</span>
                    </label>
                </div>

                <div class="form-grid content-panel" data-content-panel="vcard">
                    <div>
                        <label asp-for="VCardName" class="field-label">@UiText.Get(language, "VCardName")</label>
                        <input asp-for="VCardName" class="neo-input" />
                        <span asp-validation-for="VCardName" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="VCardCompany" class="field-label">@UiText.Get(language, "VCardCompany")</label>
                        <input asp-for="VCardCompany" class="neo-input" />
                    </div>
                    <div>
                        <label asp-for="VCardJobTitle" class="field-label">@UiText.Get(language, "VCardJobTitle")</label>
                        <input asp-for="VCardJobTitle" class="neo-input" />
                    </div>
                    <div>
                        <label asp-for="VCardPhone" class="field-label">@UiText.Get(language, "VCardPhone")</label>
                        <input asp-for="VCardPhone" class="neo-input" />
                    </div>
                    <div>
                        <label asp-for="VCardEmail" class="field-label">@UiText.Get(language, "VCardEmail")</label>
                        <input asp-for="VCardEmail" class="neo-input" />
                    </div>
                </div>

                <div class="form-grid content-panel" data-content-panel="email">
                    <div>
                        <label asp-for="EmailAddress" class="field-label">@UiText.Get(language, "EmailAddress")</label>
                        <input asp-for="EmailAddress" class="neo-input" placeholder="hello@example.com" />
                        <span asp-validation-for="EmailAddress" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="EmailSubject" class="field-label">@UiText.Get(language, "EmailSubject")</label>
                        <input asp-for="EmailSubject" class="neo-input" />
                    </div>
                    <div class="span-all">
                        <label asp-for="EmailBody" class="field-label">@UiText.Get(language, "EmailBody")</label>
                        <textarea asp-for="EmailBody" class="neo-input" rows="3"></textarea>
                    </div>
                </div>

                <div class="form-grid content-panel" data-content-panel="sms">
                    <div>
                        <label asp-for="PhoneNumber" class="field-label">@UiText.Get(language, "PhoneNumber")</label>
                        <input asp-for="PhoneNumber" class="neo-input" />
                        <span asp-validation-for="PhoneNumber" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="SmsMessage" class="field-label">@UiText.Get(language, "SmsMessage")</label>
                        <input asp-for="SmsMessage" class="neo-input" />
                    </div>
                </div>

                <div class="field-block content-panel" data-content-panel="phone">
                    <label asp-for="PhoneNumber" class="field-label">@UiText.Get(language, "PhoneNumber")</label>
                    <input asp-for="PhoneNumber" class="neo-input input-lg" placeholder="+48123123123" />
                    <span asp-validation-for="PhoneNumber" class="field-error"></span>
                </div>

                <div class="form-grid content-panel" data-content-panel="geo">
                    <div>
                        <label asp-for="GeoLatitude" class="field-label">@UiText.Get(language, "GeoLatitude")</label>
                        <input asp-for="GeoLatitude" class="neo-input" placeholder="52.2297" />
                        <span asp-validation-for="GeoLatitude" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="GeoLongitude" class="field-label">@UiText.Get(language, "GeoLongitude")</label>
                        <input asp-for="GeoLongitude" class="neo-input" placeholder="21.0122" />
                        <span asp-validation-for="GeoLongitude" class="field-error"></span>
                    </div>
                </div>

                <div class="form-grid content-panel" data-content-panel="event">
                    <div>
                        <label asp-for="EventTitle" class="field-label">@UiText.Get(language, "EventTitle")</label>
                        <input asp-for="EventTitle" class="neo-input" />
                        <span asp-validation-for="EventTitle" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="EventLocation" class="field-label">@UiText.Get(language, "EventLocation")</label>
                        <input asp-for="EventLocation" class="neo-input" />
                    </div>
                    <div>
                        <label asp-for="EventStart" class="field-label">@UiText.Get(language, "EventStart")</label>
                        <input asp-for="EventStart" class="neo-input" type="datetime-local" />
                        <span asp-validation-for="EventStart" class="field-error"></span>
                    </div>
                    <div>
                        <label asp-for="EventEnd" class="field-label">@UiText.Get(language, "EventEnd")</label>
                        <input asp-for="EventEnd" class="neo-input" type="datetime-local" />
                        <span asp-validation-for="EventEnd" class="field-error"></span>
                    </div>
                </div>

                <div class="form-grid content-panel" data-content-panel="crypto">
                    <div>
                        <label asp-for="CryptoNetwork" class="field-label">@UiText.Get(language, "CryptoNetwork")</label>
                        <select asp-for="CryptoNetwork" class="neo-input">
                            <option value="bitcoin">BTC</option>
                            <option value="ethereum">ETH</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="CryptoAmount" class="field-label">@UiText.Get(language, "CryptoAmount")</label>
                        <input asp-for="CryptoAmount" class="neo-input" placeholder="0.01" />
                    </div>
                    <div class="span-all">
                        <label asp-for="CryptoAddress" class="field-label">@UiText.Get(language, "CryptoAddress")</label>
                        <input asp-for="CryptoAddress" class="neo-input" />
                        <span asp-validation-for="CryptoAddress" class="field-error"></span>
                    </div>
                </div>

                <div class="field-block content-panel" data-content-panel="app">
                    <label asp-for="AppStoreUrl" class="field-label">@UiText.Get(language, "AppStoreUrl")</label>
                    <input asp-for="AppStoreUrl" class="neo-input input-lg" placeholder="https://apps.apple.com/... / https://play.google.com/..." />
                    <span asp-validation-for="AppStoreUrl" class="field-error"></span>
                </div>

                <div class="field-block content-panel" data-content-panel="pdf">
                    <label asp-for="PdfUrl" class="field-label">@UiText.Get(language, "PdfUrl")</label>
                    <input asp-for="PdfUrl" class="neo-input input-lg" placeholder="https://example.com/document.pdf" />
                    <span asp-validation-for="PdfUrl" class="field-error"></span>
                </div>

                <div class="form-grid content-panel" data-content-panel="social">
                    <div>
                        <label asp-for="SocialPlatform" class="field-label">@UiText.Get(language, "SocialPlatform")</label>
                        <select asp-for="SocialPlatform" class="neo-input">
                            <option value="instagram">Instagram</option>
                            <option value="linkedin">LinkedIn</option>
                            <option value="x">X</option>
                            <option value="facebook">Facebook</option>
                            <option value="youtube">YouTube</option>
                            <option value="tiktok">TikTok</option>
                        </select>
                    </div>
                    <div>
                        <label asp-for="SocialUrl" class="field-label">@UiText.Get(language, "SocialUrl")</label>
                        <input asp-for="SocialUrl" class="neo-input" placeholder="https://instagram.com/..." />
                        <span asp-validation-for="SocialUrl" class="field-error"></span>
                    </div>
                </div>

                <div class="field-block content-panel" data-content-panel="multilink">
                    <label asp-for="MultiLinks" class="field-label">@UiText.Get(language, "MultiLinks")</label>
                    <textarea asp-for="MultiLinks" class="neo-input" rows="5" placeholder="@UiText.Get(language, "MultiLinksPlaceholder")"></textarea>
                    <span asp-validation-for="MultiLinks" class="field-error"></span>
                </div>

                <div class="field-block content-panel" data-content-panel="plain">
                    <label asp-for="Text" class="field-label">@UiText.Get(language, "Text")</label>
                    <textarea asp-for="Text" class="neo-input" rows="4" placeholder="@UiText.Get(language, "TextPlaceholder")"></textarea>
                    <span asp-validation-for="Text" class="field-error"></span>
                </div>

                <details class="advanced-panel">
                    <summary>
                        <span class="material-symbols-outlined">settings</span>
                        <span>@UiText.Get(language, "AdvancedSettings")</span>
                    </summary>

                    <div class="advanced-grid">
                        <div>
                            <label asp-for="ErrorCorrectionLevel" class="field-label">@UiText.Get(language, "ErrorCorrectionLevel")</label>
                            <select asp-for="ErrorCorrectionLevel" class="neo-input">
                                @foreach (var option in Model.ErrorCorrectionOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                            <small>@UiText.Get(language, "ErrorCorrectionHelp")</small>
                        </div>
                        <div>
                            <label asp-for="DesignTemplate" class="field-label">@UiText.Get(language, "DesignTemplate")</label>
                            <select asp-for="DesignTemplate" class="neo-input">
                                @foreach (var option in Model.DesignTemplateOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>
                        <label class="toggle-line">
                            <input asp-for="DesignEnabled" type="checkbox" />
                            <span>@UiText.Get(language, "DesignEnabled")</span>
                        </label>
                        <label class="toggle-line">
                            <input asp-for="RoundedModules" type="checkbox" />
                            <span>@UiText.Get(language, "RoundedModules")</span>
                        </label>
                        <label class="toggle-line">
                            <input asp-for="DarkMode" type="checkbox" />
                            <span>@UiText.Get(language, "DarkMode")</span>
                        </label>
                        <label class="toggle-line">
                            <input asp-for="CmykSafeExport" type="checkbox" />
                            <span>@UiText.Get(language, "CmykSafeExport")</span>
                        </label>
                        <div>
                            <label asp-for="ForegroundColor" class="field-label">@UiText.Get(language, "ForegroundColor")</label>
                            <input asp-for="ForegroundColor" class="neo-input color-input" type="color" />
                        </div>
                        <div>
                            <label asp-for="BackgroundColor" class="field-label">@UiText.Get(language, "BackgroundColor")</label>
                            <input asp-for="BackgroundColor" class="neo-input color-input" type="color" />
                        </div>
                        <div>
                            <label asp-for="QrDesignGradient" class="field-label">@UiText.Get(language, "QrDesignGradient")</label>
                            <select asp-for="QrDesignGradient" class="neo-input">
                                @foreach (var option in Model.QrDesignGradientOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label asp-for="EyeStyle" class="field-label">@UiText.Get(language, "EyeStyle")</label>
                            <select asp-for="EyeStyle" class="neo-input">
                                @foreach (var option in Model.EyeStyleOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label asp-for="FrameStyle" class="field-label">@UiText.Get(language, "FrameStyle")</label>
                            <select asp-for="FrameStyle" class="neo-input">
                                @foreach (var option in Model.FrameStyleOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label asp-for="CtaText" class="field-label">@UiText.Get(language, "CtaText")</label>
                            <input asp-for="CtaText" class="neo-input" />
                        </div>
                        <div>
                            <label asp-for="BrandingLogo" class="field-label">@UiText.Get(language, "BrandingLogo")</label>
                            <input asp-for="BrandingLogo" class="neo-input file-input" type="file" accept="image/*" />
                        </div>
                    </div>
                </details>

                <details class="advanced-panel">
                    <summary>
                        <span class="material-symbols-outlined">print</span>
                        <span>@UiText.Get(language, "PrintWorkflow")</span>
                    </summary>
                    <div class="advanced-grid">
                        <div>
                            <label asp-for="PrintFormat" class="field-label">@UiText.Get(language, "PrintFormat")</label>
                            <select asp-for="PrintFormat" class="neo-input">
                                @foreach (var option in Model.PrintFormatOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label asp-for="PrintGradient" class="field-label">@UiText.Get(language, "PrintGradient")</label>
                            <select asp-for="PrintGradient" class="neo-input">
                                @foreach (var option in Model.PrintGradientOptions)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label asp-for="PrintTitle" class="field-label">@UiText.Get(language, "PrintTitle")</label>
                            <input asp-for="PrintTitle" class="neo-input" />
                        </div>
                        <div>
                            <label asp-for="PrintLabel" class="field-label">@UiText.Get(language, "PrintLabel")</label>
                            <input asp-for="PrintLabel" class="neo-input" />
                        </div>
                        <div class="span-all">
                            <label asp-for="PrintDescription" class="field-label">@UiText.Get(language, "PrintDescription")</label>
                            <textarea asp-for="PrintDescription" class="neo-input" rows="3"></textarea>
                        </div>
                        <div>
                            <label asp-for="PrintImage" class="field-label">@UiText.Get(language, "PrintImage")</label>
                            <input asp-for="PrintImage" class="neo-input file-input" type="file" accept="image/*" />
                        </div>
                        <div>
                            <label asp-for="QrPrintSizeMm" class="field-label">@UiText.Get(language, "QrPrintSizeMm")</label>
                            <input asp-for="QrPrintSizeMm" class="neo-input" type="number" min="20" max="180" />
                        </div>
                        <div>
                            <label asp-for="PrintMarginMm" class="field-label">@UiText.Get(language, "PrintMarginMm")</label>
                            <input asp-for="PrintMarginMm" class="neo-input" type="number" min="0" max="40" />
                        </div>
                        <div>
                            <label asp-for="PrintBleedMm" class="field-label">@UiText.Get(language, "PrintBleedMm")</label>
                            <input asp-for="PrintBleedMm" class="neo-input" type="number" min="0" max="8" />
                        </div>
                        <div>
                            <label asp-for="LabelCount" class="field-label">@UiText.Get(language, "LabelCount")</label>
                            <input asp-for="LabelCount" class="neo-input" type="number" min="1" max="24" />
                        </div>
                    </div>
                </details>

                <button class="generate-button" type="submit">
                    <span>@UiText.Get(language, "Generate")</span>
                    <span class="material-symbols-outlined">qr_code_2</span>
                </button>
            </form>

            <aside class="preview-panel">
                <div class="qr-orbit">
                    <div class="qr-glow"></div>
                    <div class="qr-card">
                        @if (hasResult)
                        {
                            <img src="@Model.PngDataUri" alt="@UiText.Get(language, "GeneratedQr")" />
                        }
                        else
                        {
                            <div class="qr-placeholder" aria-hidden="true">
                                @for (var i = 0; i < 81; i++)
                                {
                                    <span class="@(i % 3 == 0 || i % 7 == 0 ? "dark" : "")"></span>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="preview-status">
                    <span class="status-dot @(hasResult ? "active" : "")"></span>
                    <div>
                        <strong>@(hasResult ? UiText.Get(language, "GeneratedQr") : UiText.Get(language, "AwaitingQr"))</strong>
                        <p>@(hasResult ? generatedPayload : UiText.Get(language, "PreviewHint"))</p>
                    </div>
                </div>

                @if (hasResult)
                {
                    <div class="download-row">
                        @foreach (var format in Model.Formats)
                        {
                            <form asp-action="Download" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="text" value="@generatedPayload" />
                                <input type="hidden" name="format" value="@format.Value" />
                                <input type="hidden" name="errorCorrectionLevel" value="@Model.ErrorCorrectionLevel" />
                                <button class="download-button" type="submit">
                                    <span class="material-symbols-outlined">download</span>
                                    <span>@format.Label</span>
                                </button>
                            </form>
                        }
                    </div>
                    <button class="secondary-button" type="button" data-bs-toggle="modal" data-bs-target="#qrResultModal">
                        <span class="material-symbols-outlined">tune</span>
                        <span>@UiText.Get(language, "OpenPrintPanel")</span>
                    </button>
                }
            </aside>
        </div>
    </section>
</section>

@if (hasResult)
{
    var sheetClass = Model.PrintFormat switch
    {
        "a5" => "sheet-a5",
        "letter" => "sheet-letter",
        "dl" => "sheet-dl",
        "square" => "sheet-square",
        _ => "sheet-a4"
    };
    var labelCopies = Math.Clamp(Model.LabelCount, 1, 24);
    var printImage = Model.PrintImageDataUri;

    <div class="modal fade result-modal" id="qrResultModal" tabindex="-1" aria-labelledby="qrResultModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content glass-panel">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title" id="qrResultModalLabel">@UiText.Get(language, "ResultReady")</h2>
                        <p>@UiText.Get(language, "ResultReadyCopy")</p>
                    </div>
                    <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="@UiText.Get(language, "Close")">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="result-grid">
                        <div class="result-left">
                            <div class="qr-card modal-qr">
                                <img src="@Model.PngDataUri" alt="@UiText.Get(language, "GeneratedQr")" />
                            </div>

                            <div class="download-row">
                                @foreach (var format in Model.Formats)
                                {
                                    <form asp-action="Download" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="text" value="@generatedPayload" />
                                        <input type="hidden" name="format" value="@format.Value" />
                                        <input type="hidden" name="errorCorrectionLevel" value="@Model.ErrorCorrectionLevel" />
                                        <button class="download-button" type="submit">
                                            <span class="material-symbols-outlined">download</span>
                                            <span>@format.Label</span>
                                        </button>
                                    </form>
                                }
                            </div>

                            <form asp-action="Validate" method="post" class="glass-mini validation-card">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="generatedPayload" value="@generatedPayload" />
                                <input type="hidden" asp-for="ContentType" />
                                <input type="hidden" asp-for="ErrorCorrectionLevel" />
                                <input type="hidden" asp-for="PrintFormat" />
                                <input type="hidden" asp-for="PrintGradient" />
                                <input type="hidden" asp-for="PrintTitle" />
                                <input type="hidden" asp-for="PrintLabel" />
                                <input type="hidden" asp-for="PrintDescription" />
                                <input type="hidden" asp-for="PrintImageDataUri" />
                                <input type="hidden" asp-for="QrPrintSizeMm" />
                                <input type="hidden" asp-for="PrintMarginMm" />
                                <input type="hidden" asp-for="PrintBleedMm" />
                                <input type="hidden" asp-for="LabelCount" />
                                <input type="hidden" asp-for="CmykSafeExport" />
                                <input type="hidden" asp-for="DesignEnabled" />
                                <input type="hidden" asp-for="ForegroundColor" />
                                <input type="hidden" asp-for="BackgroundColor" />
                                <input type="hidden" asp-for="QrDesignGradient" />
                                <input type="hidden" asp-for="RoundedModules" />
                                <input type="hidden" asp-for="EyeStyle" />
                                <input type="hidden" asp-for="BrandingLogoDataUri" />
                                <input type="hidden" asp-for="FrameStyle" />
                                <input type="hidden" asp-for="CtaText" />
                                <input type="hidden" asp-for="DarkMode" />
                                <input type="hidden" asp-for="DesignTemplate" />
                                <input type="hidden" asp-for="SocialPlatform" />
                                <h3>@UiText.Get(language, "QrValidation")</h3>
                                <div class="form-grid">
                                    <div>
                                        <label asp-for="CameraProfile" class="field-label">@UiText.Get(language, "CameraProfile")</label>
                                        <select asp-for="CameraProfile" class="neo-input">
                                            @foreach (var option in Model.CameraProfileOptions)
                                            {
                                                <option value="@option.Value">@option.Label</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label asp-for="ScanDistanceCm" class="field-label">@UiText.Get(language, "ScanDistanceCm")</label>
                                        <input asp-for="ScanDistanceCm" class="neo-input" type="number" min="10" max="200" step="5" />
                                    </div>
                                    <div>
                                        <label asp-for="BlurLevel" class="field-label">@UiText.Get(language, "BlurLevel")</label>
                                        <input asp-for="BlurLevel" class="range-input" type="range" min="0" max="10" />
                                    </div>
                                    <label class="toggle-line">
                                        <input asp-for="LowLight" type="checkbox" />
                                        <span>@UiText.Get(language, "LowLight")</span>
                                    </label>
                                </div>
                                <button class="secondary-button full" type="submit">@UiText.Get(language, "RunValidation")</button>
                            </form>

                            <div class="score-card glass-mini @(isValidated ? "is-validated" : "")">
                                @if (Model.ValidationResult is not null)
                                {
                                    <div class="score-heading">
                                        <strong>@Model.ValidationResult.Verdict</strong>
                                        <span>@Model.ValidationResult.ModuleCount x @Model.ValidationResult.ModuleCount</span>
                                    </div>
                                }
                                <div class="score-row">
                                    <span>@UiText.Get(language, "ReadabilityScore")</span>
                                    <div class="stars" aria-label="@UiText.Get(language, "ReadabilityScore")">
                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            <span class="@(i <= readabilityStars ? "filled" : "")">star</span>
                                        }
                                    </div>
                                </div>
                                <div class="score-row">
                                    <span>@UiText.Get(language, "PrintSafetyScore")</span>
                                    <div class="stars" aria-label="@UiText.Get(language, "PrintSafetyScore")">
                                        @for (var i = 1; i <= 5; i++)
                                        {
                                            <span class="@(i <= printSafetyStars ? "filled" : "")">star</span>
                                        }
                                    </div>
                                </div>
                                @if (Model.ValidationResult is not null)
                                {
                                    <p>@Model.ValidationResult.Recommendation</p>
                                }
                            </div>
                        </div>

                        <div class="result-right">
                            <div class="result-toolbar">
                                <div>
                                    <h3>@UiText.Get(language, "PrintWorkflow")</h3>
                                    @if (Model.PrintWorkflowResult is not null)
                                    {
                                        <p>@Model.PrintWorkflowResult.FormatLabel, @Model.PrintWorkflowResult.EffectiveDpi DPI</p>
                                    }
                                </div>
                                <button class="generate-button compact" type="button" onclick="window.print()">
                                    <span class="material-symbols-outlined">print</span>
                                    <span>@UiText.Get(language, "PrintSavePdf")</span>
                                </button>
                            </div>

                            <div id="printArea" class="print-area">
                                <article class="print-sheet @sheetClass gradient-@Model.PrintGradient" style="--print-margin: @(Model.PrintMarginMm)mm; --print-bleed: @(Model.PrintBleedMm)mm; --qr-size: @(Model.QrPrintSizeMm)mm;">
                                    <div class="bleed-guide"></div>
                                    <div class="print-content">
                                        @if (!string.IsNullOrWhiteSpace(Model.PrintLabel))
                                        {
                                            <span class="print-label">@Model.PrintLabel</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(printImage))
                                        {
                                            <img class="print-image" src="@printImage" alt="" />
                                        }
                                        <h2>@(string.IsNullOrWhiteSpace(Model.PrintTitle) ? UiText.Get(language, "ScanQr") : Model.PrintTitle)</h2>
                                        @if (!string.IsNullOrWhiteSpace(Model.PrintDescription))
                                        {
                                            <p>@Model.PrintDescription</p>
                                        }
                                        <div class="print-qr">
                                            <img src="@Model.PngDataUri" alt="@UiText.Get(language, "GeneratedQr")" />
                                        </div>
                                        @if (labelCopies > 1)
                                        {
                                            <div class="label-strip" aria-label="@UiText.Get(language, "LabelCount")">
                                                @for (var i = 1; i <= labelCopies; i++)
                                                {
                                                    <span>@(string.IsNullOrWhiteSpace(Model.PrintLabel) ? $"Label {i}" : Model.PrintLabel)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </article>
                            </div>

                            @if (Model.PrintWorkflowResult is not null)
                            {
                                <div class="print-checks">
                                    <span class="@(Model.PrintWorkflowResult.IsDpiSafe ? "ok" : "warn")">DPI: @Model.PrintWorkflowResult.EffectiveDpi</span>
                                    <span class="@(Model.PrintWorkflowResult.IsBleedSafe ? "ok" : "warn")">Bleed: @Model.PrintBleedMm mm</span>
                                    <span class="@(Model.PrintWorkflowResult.IsCmykSafe ? "ok" : "warn")">CMYK: @(Model.PrintWorkflowResult.IsCmykSafe ? "OK" : "!")</span>
                                    <span>@UiText.Get(language, "PrintMarginMm"): @Model.PrintMarginMm mm</span>
                                </div>
                                <p class="print-note">@Model.PrintWorkflowResult.Recommendation</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (hasResult)
    {
        <script>
            window.qrResultShouldOpen = true;
            if (window.bootstrap) {
                const qrResultModal = document.getElementById('qrResultModal');
                if (qrResultModal) {
                    new bootstrap.Modal(qrResultModal).show();
                }
            }
        </script>
    }
}
