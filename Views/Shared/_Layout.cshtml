@using QRCodeGenerator.Services
@{
    var language = ViewData["Language"] as string ?? "pl";
    var theme = ViewData["Theme"] as string ?? "light";
    var isDark = theme == "dark";
    var currentPath = $"{Context.Request.Path}{Context.Request.QueryString}";
    var title = ViewData["Title"] as string ?? UiText.Get(language, "AppName");
}
<!DOCTYPE html>
<html class="@(isDark ? "dark" : "light")" lang="@(language == "en" ? "en" : "pl")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - @UiText.Get(language, "AppName")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QRCodeGenerator.styles.css" asp-append-version="true" />
</head>
<body class="app-shell" data-theme-preference="@theme" data-language="@language">
    <header class="top-shell">
        <nav class="top-nav" aria-label="Primary">
            <a class="brand-mark" asp-area="" asp-controller="Home" asp-action="Index" aria-label="@UiText.Get(language, "AppName")">
                <img src="~/logo.png" asp-append-version="true" alt="" />
                <span>QR.Logic</span>
            </a>

            <div class="nav-links">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">@UiText.Get(language, "StaticQr")</a>
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dynamic" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Dynamic">@UiText.Get(language, "DynamicQr")</a>
            </div>

            <div class="nav-actions">
                <form asp-controller="Home" asp-action="SetPreferences" method="post" class="icon-switcher" aria-label="@UiText.Get(language, "Language")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@currentPath" />
                    <input type="hidden" name="theme" value="@theme" />
                    <button class="icon-button @(language == "pl" ? "active" : "")" name="language" value="pl" type="submit" title="Polski">PL</button>
                    <button class="icon-button @(language == "en" ? "active" : "")" name="language" value="en" type="submit" title="English">US</button>
                </form>
                <form asp-controller="Home" asp-action="SetPreferences" method="post" class="icon-switcher" aria-label="@UiText.Get(language, "Theme")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@currentPath" />
                    <input type="hidden" name="language" value="@language" />
                    <button class="icon-button @(theme == "light" ? "active" : "")" name="theme" value="light" type="submit" title="@UiText.Get(language, "Light")">
                        <span class="material-symbols-outlined">light_mode</span>
                    </button>
                    <button class="icon-button @(theme == "dark" ? "active" : "")" name="theme" value="dark" type="submit" title="@UiText.Get(language, "Dark")">
                        <span class="material-symbols-outlined">dark_mode</span>
                    </button>
                </form>
            </div>
        </nav>
    </header>

    <main class="main-canvas" role="main">
        @RenderBody()
    </main>

    <footer class="footer-shell">
        <div class="footer-inner">
            <div class="brand-mark footer-brand">
                <img src="~/logo.png" asp-append-version="true" alt="" />
                <span>QR.Logic</span>
            </div>
            <span class="footer-copy">&copy; 2026 QR.Logic</span>
            <div class="footer-links">
                <a asp-area="" asp-controller="Home" asp-action="Privacy">@UiText.Get(language, "PrivacyPolicy")</a>
                <a href="mailto:contact@example.com">@UiText.Get(language, "Contact")</a>
                <a href="#">API</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
